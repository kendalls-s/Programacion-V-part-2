# ---------------------------------------------
# .gitignore para proyectos .NET / Visual Studio
# ---------------------------------------------

# Carpetas de compilación
[Bb]in/
[Oo]bj/
[Oo]ut/
[Dd]ebug/
[Rr]elease/
[Dd]ebugPublic/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
build/
bld/
[Ll]og/
[Ll]ogs/

# Carpeta y caché de Visual Studio (config de usuario, índices de Copilot)
.vs/
.vscode/

# Archivos específicos del usuario / IDE
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.rsuser

# Resultados de compilación y símbolos
*.dll
*.exe
*.pdb
*.cache
*.deps.json
*.runtimeconfig.json
*.staticwebassets.*.json
artifacts/
*.binlog

# Archivos generados por NuGet
*.nupkg
*.snupkg
project.assets.json
project.lock.json
project.fragment.lock.json
project.nuget.cache
*.nuget.props
*.nuget.targets
*.nuget.g.props
*.nuget.g.targets
*.nuget.dgspec.json
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Publicación
[Pp]ublish/
PublishScripts/
*.pubxml.user
PubTmp/

# Resultados de test y cobertura
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
TestResults/

# Bases de datos y archivos locales
*.mdf
*.ldf
*.ndf

# Archivos temporales del sistema operativo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*~
*.tmp
*.temp
*.log
*.bak
*.swp

# Archivos de configuración local con secretos
appsettings.*.local.json
secrets.json
*.env

# Empaquetados / respaldos que no deben versionarse
Web.zip