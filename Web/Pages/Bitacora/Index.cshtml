@page
@model CarnetDigitalWeb.Pages.Bitacora.IndexModel

@{
    ViewData["Title"] = "Administración de Bitácora";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="page-header">

    <h2>
        <i class="bi bi-clock-history"></i>
        Bitácora de Eventos
    </h2>

    <div>
        <button type="button"
                class="btn btn-info"
                onclick="cargarBitacora()">

            <i class="bi bi-arrow-clockwise"></i>
            Refrescar
        </button>
    </div>

</div>

<!-- ======================================== -->
<!-- FILTROS -->
<!-- ======================================== -->

<div class="filtros-wrapper">

    <div class="filtros-grid">

        <div class="form-group">

            <label for="filtroFecha">
                Fecha
            </label>

            <input id="filtroFecha"
                   type="date"
                   class="form-control" />

        </div>

        <div class="form-group">

            <label for="filtroUsuario">
                Usuario
            </label>

            <input id="filtroUsuario"
                   type="text"
                   class="form-control"
                   placeholder="Buscar por usuario..." />

        </div>

        <div class="form-group">

            <label for="filtroAccion">
                Acción
            </label>

            <input id="filtroAccion"
                   type="text"
                   class="form-control"
                   placeholder="Buscar por acción..." />

        </div>

    </div>

    <div class="filtros-acciones">

        <div class="form-group"
             style="
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
            ">

            <input id="filtroSoloErrores"
                   type="checkbox" />

            <label for="filtroSoloErrores"
                   style="margin: 0;">
                Solo errores
            </label>

        </div>

        <div style="
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            ">

            <button type="button"
                    class="btn btn-primary"
                    onclick="aplicarFiltros()">

                <i class="bi bi-funnel"></i>
                Filtrar

            </button>

            <button type="button"
                    class="btn btn-secondary"
                    onclick="limpiarFiltros()">

                <i class="bi bi-arrow-counterclockwise"></i>
                Limpiar

            </button>

        </div>

    </div>

</div>

<!-- ======================================== -->
<!-- ALERTAS -->
<!-- ======================================== -->

<div id="alertas"></div>

<!-- ======================================== -->
<!-- CARGANDO -->
<!-- ======================================== -->

<div id="loading"
     class="loading"
     style="display: none;">

    <div class="spinner-border"></div>

    <p style="margin-top: 10px;">
        Cargando bitácora...
    </p>

</div>

<!-- ======================================== -->
<!-- REGISTROS -->
<!-- ======================================== -->

<div id="listaBitacora"
     class="grid-cards">
</div>

<!-- ======================================== -->
<!-- PAGINACIÓN -->
<!-- ======================================== -->

<div id="paginacionContainer"
     style="
    display: none;
    margin-top: 30px;
    ">

    <div class="paginacion-wrapper">

        <div class="paginacion-info">

            Mostrando

            <span id="inicioMostrar">
                0
            </span>

            -

            <span id="finMostrar">
                0
            </span>

            de

            <span id="totalRegistros">
                0
            </span>

            registros

        </div>

        <div class="paginacion-botones">

            <button type="button"
                    class="btn-paginacion"
                    id="btnAnterior"
                    onclick="paginaAnterior()">

                <i class="bi bi-chevron-left"></i>
                Anterior

            </button>

            <span class="paginacion-numero"
                  id="numeroPagina">
                1
            </span>

            <button type="button"
                    class="btn-paginacion"
                    id="btnSiguiente"
                    onclick="paginaSiguiente()">

                Siguiente
                <i class="bi bi-chevron-right"></i>

            </button>

        </div>

    </div>

</div>

<!-- ======================================== -->
<!-- MODAL DETALLE -->
<!-- ======================================== -->

<div class="modal"
     id="modalDetalle">

    <div class="modal-dialog"
         style="max-width: 700px;">

        <div class="modal-content">

            <div class="modal-header modal-header-info">

                <h5 class="modal-title">
                    <i class="bi bi-info-circle"></i>
                    Detalle del Evento
                </h5>

                <button type="button"
                        class="btn-close"
                        onclick="cerrarModalDetalle()">

                    &times;

                </button>

            </div>

            <div class="modal-body">

                <div id="detalleContenido">
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        onclick="cerrarModalDetalle()">

                    Cerrar

                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="~/js/bitacora.js"
            asp-append-version="true">
    </script>

}