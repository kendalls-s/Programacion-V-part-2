@page
@model CarnetDigitalWeb.Pages.EstadoUsuario.IndexModel
@{
    ViewData["Title"] = "Cambio de Estado";
}

<div class="page-header">
    <h2><i class="bi bi-toggle2-on"></i> Cambio de Estado</h2>
</div>

<div class="grid-cards">
    <div class="card-bordered">
        <div class="card-bordered-header">
            <h3>Actualizar estado</h3>
        </div>
        <form method="post">
            <div class="card-bordered-body">
                <div class="form-group">
                    <label for="UsuarioId">Identificador del usuario *</label>
                    <input type="number" min="1" id="UsuarioId" class="form-control"
                           asp-for="UsuarioId" placeholder="Ej: 1" />
                </div>
                <div class="form-group">
                    <label for="Estado">Código de estado *</label>
                    <input type="text" id="Estado" class="form-control"
                           asp-for="Estado" placeholder="Ej: Activo, Inactivo" />
                    <small style="color:#6c757d; font-size:12px;">
                        Estados básicos: Activo, Inactivo (se permiten nuevos estados).
                    </small>
                </div>
            </div>
            <div class="card-bordered-footer">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-check2-circle"></i> Cambiar estado
                </button>
            </div>
        </form>
    </div>

    @if (Model.Resultado is not null)
    {
        <div class="card-bordered">
            <div class="card-bordered-header">
                <h3>Estado actualizado</h3>
                <span class="badge-success">@Model.Resultado.Estado</span>
            </div>
            <div class="card-bordered-body">
                <div class="info-row">
                    <span class="label"><i class="bi bi-person"></i> Usuario:</span>
                    <span class="value">@Model.Resultado.NombreCompleto</span>
                </div>
                <div class="info-row">
                    <span class="label"><i class="bi bi-hash"></i> Id usuario:</span>
                    <span class="value">@Model.Resultado.UsuarioId</span>
                </div>
                <div class="info-row">
                    <span class="label"><i class="bi bi-toggle2-on"></i> Estado:</span>
                    <span class="value">@Model.Resultado.Estado</span>
                </div>
            </div>
        </div>
    }
</div>
