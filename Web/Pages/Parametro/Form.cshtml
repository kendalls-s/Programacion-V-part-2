@page "{id?}"
@model CarnetDigitalWeb.Pages.Parametro.FormModel
@{
    ViewData["Title"] = Model.EsEdicion ? "Editar parámetro" : "Nuevo parámetro";
}

<div class="page-header">
    <h2>
        <i class="bi bi-sliders"></i>
        @(Model.EsEdicion ? "Editar Parámetro" : "Nuevo Parámetro")
    </h2>
    <div>
        <a class="btn btn-secondary" asp-page="Index">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>
</div>

<div class="form-card" style="max-width:520px">
    <form method="post">
        <input type="hidden" asp-for="EsEdicion" />

        <div class="form-group">
            <label for="Id">Código *</label>
            @if (Model.EsEdicion)
            {
                <input type="text" id="Id" class="form-control" value="@Model.Id" disabled />
                <input type="hidden" asp-for="Id" />
            }
            else
            {
                <input type="text" id="Id" class="form-control" asp-for="Id" placeholder="Código del parámetro" />
            }
        </div>

        <div class="form-group">
            <label for="Valor">Valor (máx. 500 caracteres) *</label>
            <textarea id="Valor" class="form-control" asp-for="Valor" rows="4" maxlength="500"></textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Guardar
            </button>
            <a class="btn btn-secondary" asp-page="Index">Cancelar</a>
        </div>
    </form>
</div>
