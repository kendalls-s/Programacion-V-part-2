@page
@model CarnetDigitalWeb.Pages.Parametro.IndexModel
@{
    ViewData["Title"] = "Parámetros";
}

<div class="page-header">
    <h2><i class="bi bi-sliders"></i> Administración de Parámetros</h2>
    <div>
        <a class="btn btn-primary" asp-page="Form">
            <i class="bi bi-plus-circle"></i> Nuevo Parámetro
        </a>
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="empty-state">
        <i class="bi bi-sliders" style="font-size:4rem; color:#dee2e6;"></i>
        <p>No hay parámetros registrados</p>
        <a class="btn btn-primary" asp-page="Form">
            <i class="bi bi-plus-circle"></i> Crear primer parámetro
        </a>
    </div>
}
else
{
    <div class="grid-cards">
        @{
            var indice = 0;
        }
        @foreach (var p in Model.Items)
        {
            indice++;
            <div class="card-bordered">
                <div class="card-bordered-header">
                    <h3>@p.Id</h3>
                </div>
                <div class="card-bordered-body">
                    <div class="info-row">
                        <span class="label"><i class="bi bi-card-text"></i> Valor:</span>
                        <span class="value">@p.Valor</span>
                    </div>
                </div>
                <div class="card-bordered-footer">
                    <a class="btn btn-warning btn-sm" asp-page="Form" asp-route-id="@p.Id">
                        <i class="bi bi-pencil"></i> Editar
                    </a>
                    <button type="button" class="btn btn-danger btn-sm btn-eliminar-parametro"
                            data-form="form-eliminar-@indice"
                            data-etiqueta="@p.Id">
                        <i class="bi bi-trash"></i> Eliminar
                    </button>
                </div>
            </div>

            <form method="post" asp-page-handler="Eliminar" asp-route-id="@p.Id"
                  id="form-eliminar-@indice" style="display:none;"></form>
        }
    </div>

    @if (Model.TotalPaginas > 1)
    {
        <div class="paginacion-wrapper" style="margin-top:20px;">
            <div class="paginacion-info">
                Página <span>@Model.Pagina</span> de <span>@Model.TotalPaginas</span>
            </div>
            <div class="paginacion-botones">
                @if (Model.Pagina > 1)
                {
                    <a class="btn-paginacion" asp-page="Index" asp-route-pagina="@(Model.Pagina - 1)">
                        <i class="bi bi-chevron-left"></i> Anterior
                    </a>
                }
                else
                {
                    <span class="btn-paginacion" style="opacity:.5; pointer-events:none;">
                        <i class="bi bi-chevron-left"></i> Anterior
                    </span>
                }
                <span class="paginacion-numero">@Model.Pagina</span>
                @if (Model.Pagina < Model.TotalPaginas)
                {
                    <a class="btn-paginacion" asp-page="Index" asp-route-pagina="@(Model.Pagina + 1)">
                        Siguiente <i class="bi bi-chevron-right"></i>
                    </a>
                }
                else
                {
                    <span class="btn-paginacion" style="opacity:.5; pointer-events:none;">
                        Siguiente <i class="bi bi-chevron-right"></i>
                    </span>
                }
            </div>
        </div>
    }
}

<!-- MODAL ELIMINAR -->
<div class="modal" id="modalEliminar">
    <div class="modal-dialog" style="max-width:500px;">
        <div class="modal-content">
            <div class="modal-header modal-header-danger">
                <h5><i class="bi bi-exclamation-triangle"></i> Confirmar eliminación</h5>
                <button type="button" class="btn-close" onclick="cerrarModalEliminar()">&times;</button>
            </div>
            <div class="modal-body">
                <p>¿Realmente desea eliminar el elemento seleccionado?</p>
                <p style="color:#6c757d;"><strong id="parametroEliminar"></strong></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="cerrarModalEliminar()">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="confirmarEliminar()">
                    <i class="bi bi-trash"></i> Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let formEliminarActual = null;

    document.querySelectorAll('.btn-eliminar-parametro').forEach(function(btn) {
        btn.addEventListener('click', function() {
            formEliminarActual = document.getElementById(btn.dataset.form);
            document.getElementById('parametroEliminar').textContent = btn.dataset.etiqueta || '';
            document.getElementById('modalEliminar').style.display = 'flex';
        });
    });

    function cerrarModalEliminar() {
        formEliminarActual = null;
        document.getElementById('modalEliminar').style.display = 'none';
    }

    function confirmarEliminar() {
        if (formEliminarActual) {
            formEliminarActual.submit();
        }
    }

    window.addEventListener('click', function(event) {
        if (event.target === document.getElementById('modalEliminar')) {
            cerrarModalEliminar();
        }
    });
</script>